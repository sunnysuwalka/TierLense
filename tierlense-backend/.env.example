# Copy this file to .env and edit the values for your local environment.
APP_NAME=TierLense API
APP_ENV=development
API_V1_PREFIX=/api/v1

# Create this database and user in your local PostgreSQL installation.
# Replace the password before using this configuration.
DATABASE_URL=postgresql+psycopg://tierlense:replace-this-local-password@localhost:5432/tierlense

# JSON array of browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:5173"]

# AI providers are tried in this fixed order: Groq -> OpenRouter -> Mistral.
# Keep real keys in .env only; never commit them. Fallback keys are optional.
GROQ_API_KEY=
GROQ_SEARCH_MODEL=openai/gpt-oss-20b
GROQ_ANALYSIS_MODEL=openai/gpt-oss-120b

# OpenRouter fallback. Dynamic free router chooses from currently available free models.
# Free inference is quota-limited; web-search tool usage may have separate pricing/limits.
OPENROUTER_API_KEY=
OPENROUTER_SEARCH_MODEL=openrouter/free
OPENROUTER_ANALYSIS_MODEL=openrouter/free

# Mistral fallback. Check the usage limits enabled for your Mistral account.
MISTRAL_API_KEY=
MISTRAL_SEARCH_MODEL=mistral-small-latest
MISTRAL_ANALYSIS_MODEL=mistral-small-latest

# Shared timeout and cooldown across configured providers.
GROQ_REQUEST_TIMEOUT_SECONDS=90
PROVIDER_FAILURE_COOLDOWN_SECONDS=60

# PostgreSQL-backed worker queue (no Docker/Celery/Redis).
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_ATTEMPTS=3
WORKER_LEASE_SECONDS=900
WORKER_RETRY_BASE_SECONDS=15
MAX_SOURCES_PER_INVESTIGATION=8
MIN_RELEVANCE_SCORE=0.45

# Public-source fetch limits.
SOURCE_FETCH_TIMEOUT_SECONDS=15
SOURCE_FETCH_MAX_BYTES=4000000
SOURCE_DOCUMENT_MAX_CHARS=120000
SOURCE_FETCH_MAX_REDIRECTS=3

# Bounded batched analysis: all model outputs still pass local Pydantic/evidence checks.
MAX_RELEVANCE_BATCH_SIZE=8
GROQ_RELEVANCE_MAX_COMPLETION_TOKENS=1200
GROQ_EXTRACTION_MAX_INPUT_CHARS=8000
GROQ_EXTRACTION_MAX_COMPLETION_TOKENS=2200
MAX_EXTRACTION_BATCH_INPUT_CHARS=18000
MAX_EXTRACTION_SOURCES_PER_BATCH=3
